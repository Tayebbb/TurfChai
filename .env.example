# ============================================================================
# TurfChai — Backend Deployment Environment Variables Template (.env.example)
# Copy this file to .env for local development. NEVER commit real credentials.
# ============================================================================

# Render Port (Render sets this dynamically, defaults to 8080 locally)
PORT=8080

# Production PostgreSQL Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>
SPRING_DATASOURCE_USERNAME=<DB_USER>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# Allowed Frontend Origin for CORS (e.g., Vercel App URL)
FRONTEND_URL=https://your-app.vercel.app

# AI Platform Keys (Optional)
OPENROUTER_API_KEY=
HF_API_KEY=
