# TurfChai — local development environment template
# Copy to `.env` and fill in YOUR local values:
#   cp .env.example .env
# .env is gitignored — never commit real credentials.
#
# These are read by Spring Boot (see src/main/resources/application.properties)
# via `spring.config.import=optional:file:./.env[.properties]`.
# OS environment variables override the values below.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=turfchai
DB_USER=turfchai
# Use any local dev password you like — it must match scripts/setup-db.sh
DB_PASSWORD=turfchai_dev

# Auth (JWT) — will be used once the auth module lands
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=turfchai
