# =============================================================================
# TurfChai — environment template
#
#   cp .env.example .env      (Windows:  copy .env.example .env)
#
# .env is git-ignored — never commit real keys.
# Loaded by Spring via `spring.config.import=optional:file:.env[.properties]`,
# so it is parsed as a PROPERTIES file: one KEY=value per line, no quotes,
# no `export`, and DO NOT declare the same key twice — the last occurrence
# silently wins and will override the value you filled in above it.
# =============================================================================

# -----------------------------------------------------------------------------
# AI assistant — required for the chat widget to answer
# -----------------------------------------------------------------------------
# OpenRouter is the primary provider.  Create a key at https://openrouter.ai/keys
# (free tier works; keys start with "sk-or-").
OPENROUTER_API_KEY=

# Hugging Face is the automatic fallback when OpenRouter fails or rate-limits.
# Create a read token at https://huggingface.co/settings/tokens (starts "hf_").
HF_API_KEY=

# Leaving BOTH blank is valid — the app still starts, logs
# "No LLM API keys set — AI chat endpoints will return 503",
# and the chat widget reports that the assistant is unavailable.
# Setting only one is also fine; that provider is used without a fallback.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local development normally needs NOTHING here: run with the `dev` profile and
# the app uses an in-memory H2 database with demo data seeded.
#
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
#
# Set these only to point at a real PostgreSQL instance (the default profile).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/turfchai
SPRING_DATASOURCE_USERNAME=turfchai
SPRING_DATASOURCE_PASSWORD=turfchai_dev
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Flyway owns the schema on PostgreSQL; `validate` fails fast on drift.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=turfchai
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
OTP_TTL_SECONDS=300

# Admin 2FA — SMTP for login-code emails. Leave SPRING_MAIL_HOST blank to skip
# real emails; the code is then only returned as devCode (demo mode).
# Any SMTP works (Gmail with an App Password, SendGrid, Brevo...).
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Return the generated login code in API responses (dev/demo). Set false in
# production — with SMTP configured the devCode is hidden automatically.
OTP_EXPOSE_DEV_CODE=true

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
# Server port (hosting providers usually inject this).
PORT=8080

# Allowed browser origin for CORS — comma-separated for several environments.
FRONTEND_URL=http://localhost:5173
