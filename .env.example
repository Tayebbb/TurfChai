# ============================================================================
# TurfChai — Environment Variables Template for Local Dev & Cloud Deployment (Koyeb)
# Copy this file to .env for local development. Do not commit real passwords/keys.
#   cp .env.example .env
# ============================================================================

# Server Port
PORT=8080

# PostgreSQL Database Configuration
# Local bootstrap helper: ./scripts/setup-db.sh (creates a dedicated `turfchai`
# role + database; adjust SPRING_DATASOURCE_USERNAME/PASSWORD to match it).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/turfchai
SPRING_DATASOURCE_USERNAME=turfchai
SPRING_DATASOURCE_PASSWORD=turfchai_dev
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Auth (JWT) — used once the auth module lands
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=turfchai

# AI Platform Keys (Optional)
# OpenRouter API Key (Get at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# HuggingFace API Token (Get at https://huggingface.co/settings/tokens)
HF_API_KEY=your_huggingface_api_key_here
