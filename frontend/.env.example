# ============================================================================
# TurfChai Frontend Environment Variables (.env.example)
# Copy this file to .env or .env.local for local development.
# ============================================================================

# Single-origin deployment (recommended): leave VITE_API_BASE_URL unset/blank
# and the API client uses relative /api/v1 requests against the same origin
# that serves the page — the jar serves both the SPA and the API.
#
# Split deployment (Vercel + Render, legacy): set this to the backend origin,
# e.g. https://turfchai-backend.onrender.com
VITE_API_BASE_URL=

# Optional: overrides VITE_API_BASE_URL (same meaning, alternate name)
VITE_BACKEND_ORIGIN=

# Optional: API route prefix (defaults to /api/v1)
VITE_API_BASE=/api/v1
