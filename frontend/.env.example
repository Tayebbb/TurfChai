# ============================================================================
# TurfChai Frontend Environment Variables (.env.example)
# Copy this file to .env or .env.local for local development.
# ============================================================================

# Base API URL for Spring Boot Backend
# Production (Vercel): https://turfchai.onrender.com
# Local Development: http://localhost:8080
VITE_API_BASE_URL=https://turfchai.onrender.com
# TurfChai Frontend — Production Environment Variables (.env.example)
# Copy this file to .env.local for local development.
# Configure VITE_API_BASE_URL on Vercel to point to your deployed Render backend.
# ============================================================================

# Backend API Base URL for Cloud Deployment (Render)
VITE_API_BASE_URL=https://turfchai-backend.onrender.com

# Optional: Alternative Backend Origin alias
VITE_BACKEND_ORIGIN=https://turfchai-backend.onrender.com

# Optional: Default API Route Prefix (defaults to /api/v1)
VITE_API_BASE=/api/v1
